<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="1000.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="CatalogoGestion.Empresas.Controlador.ListaSucursalController">
    <VBox layoutX="10.0" layoutY="10.0" spacing="10" stylesheets="@../../../resources/css/formulario_catalogo.css" AnchorPane.bottomAnchor="10.799999999999955" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.799999999999955" AnchorPane.topAnchor="10.0">
        <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
        </padding>

        <Label text="Lista de Sucursales" />

        <TableView fx:id="tableSucursales" prefHeight="300" prefWidth="980.0" stylesheets="@../../../resources/css/tableView.css">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
                <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Correo" />
                <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
                <TableColumn fx:id="colPais" prefWidth="80.0" text="País" />
                <TableColumn fx:id="colEstado" prefWidth="70.0" text="Activo" />
            </columns>
        </TableView>

        <HBox spacing="10">
            <Button onAction="#nuevaSucursal" styleClass="crear-button" text="Nueva Sucursal" />
            <Button onAction="#editarSucursal" styleClass="editar-button" text="Editar Sucursal" />
            <Button onAction="#cerrar" styleClass="eliminar-button" text="Cerrar" />
        </HBox>
    </VBox>
</AnchorPane>
