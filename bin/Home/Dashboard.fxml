<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="487.0" prefWidth="943.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Home.DashboardController">

    <HBox layoutX="13.0" layoutY="70.0" prefHeight="144.0" prefWidth="902.0" spacing="20.0">

        <VBox alignment="CENTER" prefHeight="237.0" prefWidth="198.0" spacing="10"
              style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);"
              styleClass="form-grid" stylesheets="@../util/css/formulario.css">

            <ImageView fitHeight="77.0" fitWidth="104.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/resources/icons/menu-hamburguesa.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Empleado" />
            <Button fx:id="btnEmpleado" onAction="#abrirEmpleado" text="Registro de Empleado" />
        </VBox>

        <VBox alignment="CENTER" prefHeight="244.0" prefWidth="234.0" spacing="10"
              style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">

            <ImageView fitHeight="72.0" fitWidth="111.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/resources/images/Tree.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Catalogo" />
            <Button fx:id="btnCatalogo" onAction="#abrirCatalogo" prefHeight="45.0" prefWidth="158.0"
                    styleClass="guardar-button" stylesheets="@../util/css/formulario.css"
                    text="Registro de Catalogos" />
        </VBox>

        <VBox alignment="CENTER" prefHeight="170.0" prefWidth="217.0" spacing="10"
              style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">

            <ImageView fitHeight="48" fitWidth="48" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/resources/icons/menu-hamburguesa.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Cliente" />
            <Button text="Ingresar" />
        </VBox>

        <VBox alignment="CENTER" prefHeight="190.0" prefWidth="182.0" spacing="10"
              style="-fx-background-color: #f0f0f0; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">

            <ImageView fitHeight="48" fitWidth="48" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/resources/icons/menu-hamburguesa.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Proveedor" />
            <Button text="Ingresar" />
        </VBox>
    </HBox>

    <Label layoutX="11.0" layoutY="35.0" prefHeight="34.0" prefWidth="895.0" style="-fx-background-color: rgb(0, 166, 255);"
           styleClass="form-label" stylesheets="@../util/css/formulario.css" text="MODULO 1" />

</AnchorPane>
