<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350.0" prefWidth="500.0" stylesheets="@../../resources/css/formulario_catalogo.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CatalogoGestion.MasterCatalogo.Controladores.MasterCatalogoRegistroController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" prefHeight="330.0" prefWidth="480.0" spacing="15.0" stylesheets="@../../resources/css/formulario.css" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <Label prefHeight="32.0" prefWidth="257.0" styleClass="form-title" text="Registro de Maestro de Catálogo" textAlignment="JUSTIFY" textOverrun="CLIP">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="100.0" text="ID Maestro:" />
                        <TextField fx:id="txtMasterId" editable="false" prefHeight="38.0" prefWidth="56.0" promptText="Generado automáticamente" />
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="99.0" text="Código:" />
                        <TextField fx:id="txtMasterCodigo" prefHeight="38.0" prefWidth="94.0" promptText="Ej: PAISES" />
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="113.0" text="Nombre:" />
                        <TextField fx:id="txtMasterNombre" prefHeight="38.0" prefWidth="341.0" promptText="Ej: Catálogo de Países" />
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="124.0" text="Descripción:" />
                        <TextArea fx:id="txtMasterDescripcion" prefHeight="64.0" prefWidth="355.0" promptText="Descripción opcional del catálogo maestro." wrapText="true" />
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER" spacing="20.0" stylesheets="@../../../resources/css/formulario_catalogo.css">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleGuardar" styleClass="guardar-button" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
