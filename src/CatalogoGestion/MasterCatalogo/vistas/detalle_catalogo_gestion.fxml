                    <TableColumn fx:id="colDetalleId" prefWidth="75.0" text="ID" />
                    <TableColumn fx:id="colDetalleCodigoItem" prefWidth="120.0" text="Código Item" />
                    <TableColumn fx:id="colDetalleNombreItem" prefWidth="330.4000244140625" text="Nombre Item" />
                    <TableColumn fx:id="colDetalleValorAdicional" prefWidth="161.5999755859375" text="Valor Adicional" />
                </columns>
                <VBox.margin>
                    <Insets left="10.0" right="10.0" />
                </VBox.margin>
               <stylesheets>
                  <URL value="@../../resources/css/tableView.css" />
