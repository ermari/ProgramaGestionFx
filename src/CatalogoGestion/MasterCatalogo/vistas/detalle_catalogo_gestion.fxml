                </VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label text="Maestro Actual:">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <Label fx:id="lblMasterInfo" text="[Nombre Maestro - Código Maestro]" />
                </children>
            </HBox>
            <TableView fx:id="detalleTable" prefHeight="350.0" prefWidth="700.0" styleClass="column-header-background">
