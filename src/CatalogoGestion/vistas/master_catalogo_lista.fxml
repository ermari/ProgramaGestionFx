<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CatalogoGestion.Controladores.MasterCatalogoListaController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="10.0" layoutY="20.0" prefHeight="480.0" prefWidth="680.0" spacing="15.0" AnchorPane.bottomAnchor="0.7999999999999545" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.799999999999955" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Listado de Maestros de Catálogos">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
                <TableView fx:id="masterTable" prefHeight="337.0" prefWidth="666.0">
                    <columns>
                        <TableColumn fx:id="colMasterId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colMasterCodigo" prefWidth="150.0" text="Código" />
                        <TableColumn fx:id="colMasterNombre" prefWidth="250.0" text="Nombre" />
                        <TableColumn fx:id="colMasterDescripcion" prefWidth="350.0" text="Descripción" />
                    </columns>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                </TableView>
                <HBox alignment="CENTER" spacing="20.0" stylesheets="@../../resources/css/formulario_catalogo.css">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleNuevoMaster" styleClass="crear-button" text="Nuevo Maestro" />
                        <Button mnemonicParsing="false" onAction="#handleEditarMaster" styleClass="editar-button" text="Editar Maestro" />
                        <Button mnemonicParsing="false" onAction="#handleEliminarMaster" styleClass="eliminar-button" text="Eliminar Maestro" />
                        <Button mnemonicParsing="false" onAction="#handleVerDetalles" styleClass="ver-detalle-button" text="Ver Detalles" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
