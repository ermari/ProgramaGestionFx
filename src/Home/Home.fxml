<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="700.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Home.HomeController">

   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <!-- Top Menu -->
         <top>
            <AnchorPane prefHeight="65.0" style="-fx-background-color: WHITE;" BorderPane.alignment="CENTER">
               <children>

                  <HBox layoutX="239.0" layoutY="1.0" prefHeight="41.0" prefWidth="298.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="25.0">
                     <children>
                        <JFXButton onAction="#handleDashboard" prefHeight="30.0" prefWidth="94.0" styleClass="menuItem" text="Dashboard">
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image>
                                    <Image url="@/resources/images/dash1.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </JFXButton>
                        <JFXButton onAction="#handleReport" prefHeight="30.0" prefWidth="112.0" styleClass="menuItem" text="Report">
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image>
                                    <Image url="@/resources/images/report1.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </JFXButton>


                        <JFXButton onAction="#handleExit" prefHeight="30.0" prefWidth="90.0" styleClass="menuItem" text="Exit">
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image>
                                    <Image url="@/resources/images/ExitGris.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </JFXButton>


                     </children>
                  </HBox>
                  <Label fx:id="Menu" layoutX="14.0" layoutY="36.0" prefHeight="22.0" prefWidth="92.0" text="MENU" textFill="#b7b7b7" AnchorPane.bottomAnchor="7.007998687500045" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="618.063980710938" AnchorPane.topAnchor="36.0">
                     <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@/resources/images/menu1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="MenuClose" layoutX="14.0" layoutY="36.0" prefHeight="22.0" prefWidth="92.0" text="MENU" textFill="#b7b7b7" AnchorPane.bottomAnchor="7.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="594.0" AnchorPane.topAnchor="36.0">
                     <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@/resources/images/menu1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>
         </top>

         <!-- Sidebar -->
         <left>
            <AnchorPane fx:id="slider" prefWidth="176.0" style="-fx-background-color: #0A4969;" BorderPane.alignment="CENTER">
               <children>
                  <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="53.0">
                     <children>
                        <JFXButton alignment="BASELINE_LEFT" onAction="#handleDashboard" prefHeight="38.0" prefWidth="176.0" styleClass="sidebarItem" text="Dashboard" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image><Image url="@/resources/images/dash.png" /></image>
                              </ImageView>
                           </graphic>
                        </JFXButton>

                        <JFXButton alignment="BASELINE_LEFT" onAction="#handleReport" prefHeight="38.0" prefWidth="176.0" styleClass="sidebarItem" text="Report" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image><Image url="@/resources/images/report.png" /></image>
                              </ImageView>
                           </graphic>
                        </JFXButton>

                        <JFXButton alignment="BASELINE_LEFT" onAction="#handleExit" prefHeight="38.0" prefWidth="210.0" styleClass="sidebarItem" text="Exit" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                           <graphic>
                              <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                                 <image><Image url="@/resources/images/ExitGris.png" /></image>
                              </ImageView>
                           </graphic>
                        </JFXButton>
                        <Label fx:id="lblNombre" prefHeight="22.0" prefWidth="243.0" text="user" />
                        <Label fx:id="lblEmpresa" prefHeight="18.0" prefWidth="254.0" text="Label" />
                        <Label fx:id="lblSucursal" prefHeight="18.0" prefWidth="254.0" text="Label" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </left>

         <!-- Center: Título fijo + contentArea dinámico -->
         <center>
            <VBox spacing="5.0" BorderPane.alignment="CENTER">
               <children>

                  <AnchorPane fx:id="contentArea" prefHeight="302.0" prefWidth="486.0" style="-fx-background-color: #f4f4f4;" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </center>

      </BorderPane>
   </children>
</AnchorPane>
