<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="250.0" prefWidth="400.0" stylesheets="@../../../Login/login.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Home.User.Controlador.RegistrarPermisoController">

    <children>
        <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
            <Label prefHeight="31.0" prefWidth="282.0" text="Nombre del Permiso:" />
            <TextField fx:id="txtNombre" promptText="Nombre del permiso" />

            <Label text="Descripción:" />
            <TextArea fx:id="txtDescripcion" prefHeight="100" wrapText="true" />

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#guardarPermiso" text="Guardar" />
                <Button onAction="#cerrarVentana" text="Cancelar" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
