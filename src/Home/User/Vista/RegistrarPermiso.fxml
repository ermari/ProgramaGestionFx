<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Home.User.Controlador.RegistrarPermisoController"
            prefWidth="400.0" prefHeight="250.0">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <Label text="Nombre del Permiso:" />
            <TextField fx:id="txtNombre" promptText="Nombre del permiso" />

            <Label text="Descripción:" />
            <TextArea fx:id="txtDescripcion" wrapText="true" prefHeight="100"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Guardar" onAction="#guardarPermiso"/>
                <Button text="Cancelar" onAction="#cerrarVentana"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
