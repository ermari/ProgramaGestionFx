<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="296.0" prefWidth="454.0" spacing="10" stylesheets="@../../../Login/login.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Home.User.Controlador.SelectorEmpresaSucursalController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label prefHeight="34.0" prefWidth="378.0" styleClass="form-title" text="Seleccione una Empresa y una Sucursal">
      <font>
         <Font name="Bodoni MT Black Italic" size="16.0" />
      </font>
      <textFill>
         <RadialGradient centerX="0.8451327201539436" radius="0.5">
            <stops>
               <Stop>
                  <color>
                     <Color red="0.5303999781608582" green="0.6566487550735474" blue="0.6800000071525574" />
                  </color>
               </Stop>
               <Stop offset="1.0">
                  <color>
                     <Color red="1.0" green="1.0" blue="1.0" />
                  </color>
               </Stop>
            </stops>
         </RadialGradient>
      </textFill></Label>
    <ComboBox fx:id="comboEmpresa" prefHeight="23.0" prefWidth="368.0" promptText="Seleccione Empresa" />
    <ComboBox fx:id="comboSucursal" prefHeight="22.0" prefWidth="368.0" promptText="Seleccione Sucursal" />

    <Button onAction="#onAceptar" prefWidth="100" text="Aceptar" />
</VBox>
