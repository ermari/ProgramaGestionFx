<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Home.User.Controlador.ListarPermisosController">

    <!-- Encabezado -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Permisos" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#salir" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" text="Salir" />
        </HBox>
    </top>

    <!-- Contenido principal -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 15;">
            <!-- Barra de búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10" VBox.vgrow="ALWAYS">
                <TextField fx:id="txtBuscarPermiso" promptText="Buscar permiso por nombre..." HBox.hgrow="ALWAYS" />
                <Button onAction="#buscarPermiso" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Buscar" HBox.hgrow="ALWAYS" />
                <Button onAction="#abrirFormularioAgregar" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Agregar" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Tabla de permisos -->
            <TableView fx:id="tablePermisos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre del Permiso" />
                    <TableColumn fx:id="colDescripcion" prefWidth="400" text="Descripción" />
                    <TableColumn fx:id="colAcciones" maxWidth="218.39998779296877" minWidth="-1.0" prefWidth="218.39998779296877" resizable="false" text="Acciones" />
                </columns>
            <stylesheets>
               <URL value="@../../../resources/css/tableView.css" />
               <URL value="@../../../resources/css/estilos_botones.css" />
            </stylesheets>
            </TableView>
        </VBox>
    </center>
</BorderPane>
