<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450" prefWidth="450" stylesheets="@../resources/css/formulario_catalogo.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Catalogo.RegistroCatalogoController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="25.0" layoutY="25.0" prefHeight="400.0" prefWidth="400.0" spacing="15.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>
                <Label styleClass="form-title" text="Registro de Catálogo">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </Label>
                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Código:" />
                        <TextField fx:id="codigoField" promptText="Ingrese el código" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Valor:" />
                        <TextField fx:id="valorField" promptText="Ingrese el valor" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Descripción:" />
                        <TextField fx:id="descripcionField" prefHeight="38.0" prefWidth="223.0" promptText="Ingrese la descripción" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Orden:" />
                        <TextField fx:id="ordenField" prefHeight="38.0" prefWidth="146.0" promptText="Ingrese el orden" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Superior:" />
                        <ComboBox fx:id="comboSuperior" prefHeight="26.0" prefWidth="250.0" promptText="Seleccione superior" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="350.0" spacing="10.0" styleClass="input-row">
                    <children>
                        <Label prefWidth="90.0" text="Expandible:"/>
                        <ToggleButton fx:id="toggleExpandible" text="No"/> </children>
                </HBox>


                <Region VBox.vgrow="ALWAYS" /> <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" spacing="10.0">
                <children>
                    <Button onAction="#guardarCatalogo" prefHeight="35.0" prefWidth="120.0" styleClass="primary-button" text="Guardar">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../resources/images/save1.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </children>
                <VBox.margin>
                    <Insets bottom="10.0" top="10.0" />
                </VBox.margin>
            </HBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
