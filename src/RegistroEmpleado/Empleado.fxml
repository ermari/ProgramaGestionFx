<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../resources/css/tableView.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RegistroEmpleado.EmpleadoController">
    <children>
        <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="10.0">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#agregarEmpleado" prefHeight="24.0" prefWidth="162.0" styleClass="guardar-button" stylesheets="@../resources/css/formulario.css" text="Agregar Empleado">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../resources/images/add.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ComboBox fx:id="filterCombo" prefWidth="150.0" promptText="Filtrar por" styleClass="comboBox">
                  <stylesheets>
                     <URL value="@../resources/css/formulario.css" />
                     <URL value="@../resources/css/style-varios.css" />
                  </stylesheets></ComboBox>
                    <TextField fx:id="filterField" prefHeight="30.0" prefWidth="500.0" promptText="Buscar empleado..." />
                    <Button onAction="#refrescarTabla" styleClass="search-box" stylesheets="@../resources/css/style-varios.css" text="Buscar" />
                </HBox>

                <TableView fx:id="tableview" prefHeight="410.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="EmpID" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="empName" prefWidth="150.0" text="Nombre" />
                        <TableColumn fx:id="empEmail" prefWidth="180.0" text="Email" />
                        <TableColumn fx:id="department" prefWidth="120.0" text="Departamento" />
                        <TableColumn fx:id="salary" prefWidth="100.0" text="Salario" />
                        <TableColumn fx:id="actionsColumn" prefWidth="75.0" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Pagination fx:id="pagination" prefHeight="24.0" prefWidth="879.0" />

                <HBox alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="200.0" styleClass="footer">
                    <children>
                        <Label text="© 2025 Mi Aplicación de Empleados. Todos los derechos reservados.">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
