<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Comprobantes.Controller.ComprobantesGrabadosController">
    <stylesheets>
        <URL value="@../../resources/css/tableView.css" /> </stylesheets>
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label styleClass="form-title" text="Lista de Comprobantes Grabados" VBox.vgrow="NEVER" />
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10;">
            <Label text="Buscar por Fecha:" />
            <DatePicker fx:id="fechaInicioPicker" />
            <Label text="a" />
            <DatePicker fx:id="fechaFinPicker" />
            <Label text="Número:" />
            <TextField fx:id="numeroComprobanteBusquedaField" promptText="Número de comprobante"/>
            <Button onAction="#buscarComprobantes" text="Buscar" />
            <Button onAction="#limpiarFiltros" text="Limpiar" />
        </HBox>
        <TableView fx:id="comprobantesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="fechaColumn" prefWidth="100.0" text="Fecha" />
                <TableColumn fx:id="numeroColumn" prefWidth="120.0" text="Número" />
                <TableColumn fx:id="conceptoColumn" prefWidth="400.0" text="Concepto" />
                <TableColumn fx:id="totalDebitosColumn" prefWidth="80.0" text="Débitos" />
                <TableColumn fx:id="totalCreditosColumn" prefWidth="80.0" text="Créditos" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10;">
            <Button onAction="#editarComprobante" text="Editar Comprobante Seleccionado" />
            <Button onAction="#eliminarComprobante" text="Eliminar Comprobante Seleccionado" />
        </HBox>
    </VBox>
</AnchorPane>